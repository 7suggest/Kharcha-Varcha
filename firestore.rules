rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMemberOf(memberIds) {
      return isSignedIn() && request.auth.uid in memberIds;
    }

    function validTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // Users
    function isValidUser(data) {
      return data.id is string
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && data.email is string && data.email.size() <= 150
        && (!('phoneNumber' in data) || data.phoneNumber is string)
        && (!('upiId' in data) || data.upiId is string)
        && (!('avatarColorHex' in data) || data.avatarColorHex is string)
        && (!('defaultCurrency' in data) || data.defaultCurrency is string)
        && validTimestamp(data.createdAt)
        && validTimestamp(data.updatedAt);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.id == userId;
      allow update: if isOwner(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.id == userId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);
    }

    // Groups
    function isValidGroup(data) {
      return data.id is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!('description' in data) || data.description is string)
        && (!('category' in data) || data.category is string)
        && data.createdBy is string
        && data.memberIds is list
        && (!('memberNames' in data) || data.memberNames is map)
        && validTimestamp(data.createdAt)
        && validTimestamp(data.updatedAt);
    }

    match /groups/{groupId} {
      allow read: if isMemberOf(resource.data.memberIds);
      allow create: if isSignedIn()
        && isValidGroup(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isMemberOf(resource.data.memberIds)
        && isValidGroup(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Expenses
    function isValidExpense(data) {
      return data.id is string
        && data.groupId is string
        && data.titleNote is string && data.titleNote.size() > 0 && data.titleNote.size() <= 150
        && (!('category' in data) || data.category is string)
        && (data.totalAmount is number || data.totalAmount is int || data.totalAmount is float) && data.totalAmount >= 0
        && data.paidByUserId is string
        && (!('splitType' in data) || data.splitType is string)
        && data.participantIds is list
        && data.memberIds is list
        && (!('customSharesCsv' in data) || data.customSharesCsv is string)
        && (!('receiptUri' in data) || data.receiptUri is string)
        && (!('expenseDate' in data) || data.expenseDate is number || data.expenseDate is int)
        && validTimestamp(data.createdAt)
        && validTimestamp(data.updatedAt);
    }

    match /expenses/{expenseId} {
      allow read: if isMemberOf(resource.data.memberIds);
      allow create: if isSignedIn()
        && isValidExpense(request.resource.data)
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isMemberOf(resource.data.memberIds)
        && isValidExpense(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isMemberOf(resource.data.memberIds);
    }

    // Settlements
    function isValidSettlement(data) {
      return data.id is string
        && data.groupId is string
        && data.fromUserId is string
        && data.toUserId is string
        && (data.amount is number || data.amount is int || data.amount is float) && data.amount > 0
        && (!('note' in data) || data.note is string)
        && (!('settledAt' in data) || data.settledAt is number || data.settledAt is int)
        && data.memberIds is list
        && validTimestamp(data.createdAt)
        && validTimestamp(data.updatedAt);
    }

    match /settlements/{settlementId} {
      allow read: if isMemberOf(resource.data.memberIds);
      allow create: if isSignedIn()
        && isValidSettlement(request.resource.data)
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isMemberOf(resource.data.memberIds)
        && isValidSettlement(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isMemberOf(resource.data.memberIds);
    }
  }
}
